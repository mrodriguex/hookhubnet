digraph HookHubNetArchitecture {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=lightblue, fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=10];

    // Clients
    Client1 [label="Client 1\n(TCP Connection)", fillcolor=lightgreen];
    Client2 [label="Client 2\n(TCP Connection)", fillcolor=lightgreen];

    // Hub
    Hub [label="HookHubNet.Hub\n(ASP.NET Core)\n- WebSocket Server\n- Port Assignment\n- Tunnel Registry\n- Data Forwarding", fillcolor=lightcoral, shape=box];

    // Hooks
    Hook1 [label="HookHubNet.Hook 1\n(Console App)\n- WebSocket Client\n- TCP Forwarding", fillcolor=lightyellow];
    Hook2 [label="HookHubNet.Hook 2\n(Console App)\n- WebSocket Client\n- TCP Forwarding", fillcolor=lightyellow];

    // Backends
    Backend1 [label="Backend Service 1\n(e.g., Web Server)", fillcolor=lightcyan];
    Backend2 [label="Backend Service 2\n(e.g., Database)", fillcolor=lightcyan];

    // Connections
    Client1 -> Hub [label="TCP Port 5001"];
    Client2 -> Hub [label="TCP Port 5002"];

    Hub -> Hook1 [label="WebSocket\n(ws://hub/hookhubnet?id=hook1)", dir=both];
    Hub -> Hook2 [label="WebSocket\n(ws://hub/hookhubnet?id=hook2)", dir=both];

    Hook1 -> Backend1 [label="TCP Forwarding"];
    Hook2 -> Backend2 [label="TCP Forwarding"];

    // Invisible edges for layout
    {rank=same; Client1 Client2}
    {rank=same; Hook1 Hook2}
    {rank=same; Backend1 Backend2}
}